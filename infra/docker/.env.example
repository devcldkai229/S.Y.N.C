# =============================================================================
# SYNC Platform — Docker Compose secrets (local full stack)
# Copy → .env  then:  .\scripts\up-full.ps1 -Build
# Never commit .env. Values marked DEV are ok for local; real third-party keys optional.
# =============================================================================

# ── Auth / JWT (must be IDENTICAL on every service; min ~32 chars) ───────────
# Avoid bare $ # in .env (Compose expands $). Match host appsettings if hybrid.
JWT_SIGNING_KEY=sync_local_jwt_signing_key_min_32_chars_docker_2026
JWT_ISSUER=sync-lifestyle-iam-dev
JWT_AUDIENCE=sync-lifestyle-clients-dev
INTERNAL_API_KEY=dev_internal_api_key_sync_platform

# ── Infra ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=12345
POSTGRES_HOST_PORT=5434
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6379
RABBITMQ_USER=sync_mq_user
RABBITMQ_PASSWORD=SyncMqSecurePassword2026
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── AWS S3 (real buckets sync-pub-assets / sync-private-assets — no MinIO) ───
AWS_REGION=ap-southeast-1
AWS_PROFILE=default
# Windows: leave empty → mounts %USERPROFILE%\.aws
# Linux/macOS: AWS_CREDENTIALS_DIR=$HOME/.aws
AWS_CREDENTIALS_DIR=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STORAGE_BUCKET=sync-private-assets
STORAGE_PUBLIC_BUCKET=sync-pub-assets
STORAGE_KEY_PREFIX=docker/

# ── LLM (required for chat / RCM / SmartPush AI features) ───────────────────
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Google Sign-In (Web client ID). Empty = password-only local login ───────
GOOGLE_CLIENT_ID=366172488368-n76f7r1ab2joffko6cvf2b3564togekv.apps.googleusercontent.com
GOOGLE_CLIENT_ID_2=366172488368-4brct5chejltaa6rlk42b0pnn2a53skr.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=366172488368-n76f7r1ab2joffko6cvf2b3564togekv.apps.googleusercontent.com

# ── Email Brevo (optional; verify-email flows). Disabled if password empty ──
EMAIL_FROM=ngykhai229@gmail.com
EMAIL_FROM_NAME=Sync Lifestyle
BREVO_ENABLED=false
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USERNAME=
BREVO_PASSWORD=
EMAIL_VERIFICATION_BASE_URL=http://localhost:5057

# ── PayOS (payment). Dev sample keys from Payment appsettings.example ───────
PAYOS_CLIENT_ID=3d2983d2-3b36-41b2-8a8a-c56b29450f26
PAYOS_API_KEY=7a6f1a34-43cb-4e74-bd7e-db175f8820b4
PAYOS_CHECKSUM_KEY=f9306d398ceae90e66ebc76400fc1da9a45fae9fe56088c544162522fed43d7a
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# ── Google Play Billing (local: simulate) ───────────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.sync.sync_app
GOOGLE_PLAY_DEV_SIMULATE=true

# ── Ahamove delivery (order uses sandbox simulation when empty) ─────────────
AHAMOVE_API_KEY=
AHAMOVE_MOBILE=0978504380
AHAMOVE_USE_SANDBOX=true

# AWS Location (challenge route + Sync Foods reverse geocode)
# Requires valid AWS creds (profile/keys above) with geo:CalculateRoute / SearchPlaceIndex*.
AWS_LOCATION_PLACE_INDEX=sync-place-index
AWS_LOCATION_ROUTE_CALCULATOR=sync-route-calculator
AWS_LOCATION_DATA_PROVIDER=Grab

# AWS Location MapLibre (Flutter web / mobile-web image dart-defines)
AWS_MAP_API_KEY=
AWS_MAP_REGION=ap-southeast-1
AWS_MAP_NAME=sync-map
AWS_MAP_STYLE=Hybrid

# ── IAM seed ────────────────────────────────────────────────────────────────
IAM_SEED_DEMO_USERS=true
IAM_DEMO_USER_PASSWORD=SyncDemo123!

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5057
FLUTTER_BASE_URL=http://localhost:5057/api
WEB_HOST_PORT=3000
MOBILE_WEB_HOST_PORT=3002
PUBLIC_MEDIA_BASE_URL=http://localhost:5057/api/v1/media

# Legal pack (injected into web static build)
# Leave entity/address empty to use ui/web placeholders.ts UTF-8 defaults (no home street address on public pages).
NEXT_PUBLIC_LEGAL_WEBSITE=https://synctis.in
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_NAME_EN=
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=ngykhai229@gmail.com
NEXT_PUBLIC_LEGAL_SUPPORT_PHONE=0978504380
NEXT_PUBLIC_LEGAL_REGISTERED_ADDRESS=

# ── Observability (profile optional) ────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=sync_langfuse_nextauth_dev_change_me
LANGFUSE_SALT=sync_langfuse_salt_dev_change_me
