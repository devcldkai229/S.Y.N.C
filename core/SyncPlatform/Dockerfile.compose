# Local docker-compose runtime: non-chiseled aspnet + curl healthchecks.
# Production/ECS continues to use Dockerfile (chiseled).
# syntax=docker/dockerfile:1.7
ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-noble AS build
ARG PROJECT
WORKDIR /src
COPY . .
RUN set -eux; \
    PROJ_DIR="$(dirname "$PROJECT")"; \
    if [ ! -f "$PROJ_DIR/appsettings.json" ] && [ -f "$PROJ_DIR/appsettings.json.example" ]; then \
      cp "$PROJ_DIR/appsettings.json.example" "$PROJ_DIR/appsettings.json"; \
    fi; \
    if [ ! -f "$PROJ_DIR/appsettings.Development.json" ] && [ -f "$PROJ_DIR/appsettings.Development.json.example" ]; then \
      cp "$PROJ_DIR/appsettings.Development.json.example" "$PROJ_DIR/appsettings.Development.json"; \
    fi
RUN dotnet restore "$PROJECT"
RUN dotnet publish "$PROJECT" -c Release -o /app /p:UseAppHost=false
# Chuẩn hoá entrypoint thành app.dll: phải copy CẢ runtimeconfig.json + deps.json,
# nếu không `dotnet app.dll` sẽ không thấy app.runtimeconfig.json → chạy nhầm
# self-contained → thiếu libhostpolicy.so → crash.
RUN set -eux; ASSEMBLY="$(basename "$PROJECT" .csproj)"; \
    cp "/app/$ASSEMBLY.dll" /app/app.dll; \
    cp "/app/$ASSEMBLY.runtimeconfig.json" /app/app.runtimeconfig.json; \
    cp "/app/$ASSEMBLY.deps.json" /app/app.deps.json

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-noble AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/app/.aws \
    && chown -R app:app /home/app
ENV ASPNETCORE_URLS=http://+:8080 \
    HOME=/home/app \
    DOTNET_gcServer=1 \
    TZ=Asia/Ho_Chi_Minh
WORKDIR /app
COPY --from=build /app .
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["dotnet", "app.dll"]
