{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "InternalApiKey": "dev_internal_api_key_sync_platform",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PaymentDatabase": "Host=localhost;Port=5434;Database=sync_payment;Username=postgres;Password=12345;Include Error Detail=true"
  },
  "PayOS": {
    "ClientId": "3d2983d2-3b36-41b2-8a8a-c56b29450f26",
    "ApiKey": "7a6f1a34-43cb-4e74-bd7e-db175f8820b4",
    "ChecksumKey": "f9306d398ceae90e66ebc76400fc1da9a45fae9fe56088c544162522fed43d7a",
    "ReturnUrl": "http://localhost:3000/payment/success",
    "CancelUrl": "http://localhost:3000/payment/cancel",
    "MonthlyDurationDays": 30,
    "YearlyDurationDays": 365
  },
  "GooglePlay": {
    "PackageName": "com.sync.sync_app",
    "ServiceAccountJson": "",
    "RtdnSharedSecret": "",
    "DevSimulateVerify": false,
    "MonthlyDurationDays": 30
  },
  "AllowedHosts": "*",
