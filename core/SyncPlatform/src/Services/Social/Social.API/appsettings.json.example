{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "ConnectionStrings": {
    "SocialDatabase": "mongodb://localhost:27018"
  },
  "MongoDB": {
    "SocialDatabaseName": "sync_social"
  },
  "Social": {
    "Seed": {
      "Enabled": true,
      "SeedDemoData": true
    },
    "Maintenance": {
      "AllowShareCodeBackfillApi": false,
      "BackfillShareCodesOnStartup": false
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "ap-southeast-1"
  },
  "Storage": {
    "Bucket": "sync-private-assets",
    "PublicBaseUrl": "http://localhost:5057/api/v1/media",
    "MaxFileSizeMb": 50
  },
  "AwsLocation": {
    "Region": "ap-southeast-1",
    "RouteCalculatorName": "sync-route-calculator",
    "DataProvider": "Grab",
    "Profile": "default",
    "PlaceIndexName": "sync-place-index",
    "MapName": "sync-map",
    "MapStyle": "Hybrid"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "sync-lifestyle-iam",
    "Audience": "sync-lifestyle-clients",
    "SecretKey": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "_readme": "Copy to appsettings.json (gitignored) via setup-appsettings.ps1."
}
