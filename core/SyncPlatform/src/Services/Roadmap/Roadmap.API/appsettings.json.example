{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "InternalApiKey": "dev_internal_api_key_sync_platform",
  "ConnectionStrings": {
    "RoadmapDatabase": "mongodb://localhost:27018"
  },
  "MongoDB": {
    "RoadmapDatabaseName": "sync_roadmap"
  },
  "AWS": {
    "Profile": "default",
    "Region": "ap-southeast-1"
  },
  "Storage": {
    "Bucket": "sync-pub-assets",
    "PublicBaseUrl": "http://localhost:5057/api/v1/media",
    "MaxFileSizeMb": 10
  },
  "Roadmap": {
    "Seed": {
      "Enabled": true,
      "SeedDemoData": true
    }
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "sync-lifestyle-iam",
    "Audience": "sync-lifestyle-clients",
    "SecretKey": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "_readme": "Copy to appsettings.json (gitignored) via setup-appsettings.ps1."
}
