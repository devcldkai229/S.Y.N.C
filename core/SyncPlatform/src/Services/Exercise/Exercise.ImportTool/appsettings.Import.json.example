{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "_readme": "Copy to appsettings.Import.json and fill secrets. Do not commit credentials.",
  "ConnectionStrings": {
    "ExerciseDatabase": "mongodb://syncapp:PASSWORD@127.0.0.1:27027/sync_exercise?authSource=admin"
  },
  "MongoDB": {
    "ExerciseDatabaseName": "sync_exercise"
  },
  "AWS": {
    "Profile": "default",
    "Region": "ap-southeast-1"
  },
  "Storage": {
    "Bucket": "sync-pub-assets",
    "KeyPrefix": "prod/",
    "PublicRead": true,
    "PublicBaseUrl": "https://cdn.synctis.in",
    "UseMediaProxy": false,
    "MediaProxyBaseUrl": "",
    "MaxFileSizeMb": 50,
    "MaxThumbnailSizeMb": 5
  },
  "FreeExerciseDb": {
    "JsonUrl": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/dist/exercises.json",
    "ImageBaseUrl": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/"
  },
  "Translate": {
    "Provider": "passthrough"
  },
  "Enrichment": {
    "OllamaBaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:latest",
    "Temperature": 0.2,
    "Concurrency": 2
  }
}
