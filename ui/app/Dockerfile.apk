# One-shot APK build (profile: mobile-apk). Output: infra/docker/artifacts/mobile/
FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .

ARG BASE_URL=http://10.0.2.2:5057/api
RUN flutter build apk --debug \
    --dart-define=BASE_URL=${BASE_URL}

FROM alpine:3.21 AS export
RUN mkdir -p /artifacts
COPY --from=build /app/build/app/outputs/flutter-apk/app-debug.apk /artifacts/sync-app-debug.apk
CMD ["cp", "/artifacts/sync-app-debug.apk", "/out/sync-app-debug.apk"]
