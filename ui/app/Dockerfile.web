# Flutter Web -> nginx (local docker-compose profile: ui)
FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app

# Dependency layer (cache until pubspec changes)
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
ARG BASE_URL=http://localhost:5057/api
ARG AWS_MAP_API_KEY=
ARG AWS_MAP_REGION=ap-southeast-1
ARG AWS_MAP_NAME=sync-map
ARG AWS_MAP_STYLE=Hybrid
RUN flutter build web --release \
    --dart-define=BASE_URL=${BASE_URL} \
    --dart-define=AWS_MAP_API_KEY=${AWS_MAP_API_KEY} \
    --dart-define=AWS_MAP_REGION=${AWS_MAP_REGION} \
    --dart-define=AWS_MAP_NAME=${AWS_MAP_NAME} \
    --dart-define=AWS_MAP_STYLE=${AWS_MAP_STYLE}

FROM nginx:alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
CMD ["nginx", "-g", "daemon off;"]
