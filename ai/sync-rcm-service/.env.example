# Database (pgvector) — shared local compose postgres (sync-postgres :5434)
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5434/sync_ai_agent

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT — must match configs/appsettings.Shared.Development.json
JWT_SECRET_KEY=
JWT_ISSUER=sync-lifestyle-iam-dev
JWT_AUDIENCE=sync-lifestyle-clients-dev

# Inter-service URLs (direct, not via gateway)
EXERCISE_SERVICE_URL=http://localhost:5187
IAM_SERVICE_URL=http://localhost:5288
ROADMAP_SERVICE_URL=http://localhost:5118

EMBEDDING_DIM=1536
EMBEDDING_TOP_K=12
