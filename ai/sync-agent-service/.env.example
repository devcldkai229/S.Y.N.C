# ---- LLM providers ----
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
INTENT_CLASSIFIER_PROVIDER=deepseek
INTENT_CLASSIFIER_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://localhost:11434

# ---- .NET internal integration ----
# Gọi service nội bộ qua Internal API Key (xem InternalApiKeyMiddleware trong .NET)
INTERNAL_API_KEY=dev_internal_api_key_sync_platform
IAM_BASE_URL=http://localhost:5288
ROADMAP_BASE_URL=http://localhost:5118
EXERCISE_BASE_URL=http://localhost:5187
NUTRITION_BASE_URL=http://localhost:5122
MARKETPLACE_BASE_URL=http://localhost:5119
ORDER_BASE_URL=http://localhost:5123
PAYMENT_BASE_URL=http://localhost:5084
NOTIFICATION_BASE_URL=http://localhost:5106
SOCIAL_BASE_URL=http://localhost:5120

# ---- Feature flags ----
VISION_ENABLED=false

# ---- Infra ----
REDIS_URL=redis://localhost:6379/2
POSTGRES_DSN=postgresql://postgres:12345@localhost:5434/sync_ai

# ---- JWT (verify token phát hành bởi IAM) ----
JWT_ISSUER=sync-lifestyle-iam-dev
JWT_AUDIENCE=sync-lifestyle-clients-dev
JWT_SIGNING_KEY="your-key-here"

# ---- Observability ----
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=false
FLOW_LOG_ENABLED=true

# ---- Cost / budget ----
DEFAULT_TOKEN_BUDGET=8000
PREMIUM_TOKEN_BUDGET=12000
ULTRA_TOKEN_BUDGET=16000
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.92
EMBEDDING_MODEL=bge-m3

# ---- Runtime ----
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*

# ---- Rate-limit theo SubscriptionTier (req/phút) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_PER_MIN=8
RATE_LIMIT_PREMIUM_PER_MIN=40
RATE_LIMIT_ULTRA_PER_MIN=120
